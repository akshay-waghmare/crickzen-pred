# Telegram Prediction Ledger Configuration
# Copy this file to .env and fill in your values

# Telegram Bot Token (get from @BotFather)
# Format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram Channel ID
# Format: @channel_username OR numeric ID like -1001234567890
# Bot must be admin of channel with "Post Messages" permission
TELEGRAM_CHANNEL_ID=@your_channel_here

# Storage file path (default: data/telegram_predictions.jsonl)
# TELEGRAM_STORAGE_PATH=data/telegram_predictions.jsonl

# Accuracy tracker CSV path (default: data/telegram_signal_accuracy_tracker.csv)
# TELEGRAM_SIGNAL_TRACKER_PATH=data/telegram_signal_accuracy_tracker.csv

# Public dashboard CTA for Telegram signals
PUBLIC_DASHBOARD_BASE_URL=https://app.crickzen.com

# Live predictor JSON used to prefill Telegram public signals.
# On prod the predictor writes to data/dashboard_states/<match-hash>.json.
# Use --source-dir data/dashboard_states with the signal runner to auto-discover
# the latest file, so you don't need to update this path each match.
# TELEGRAM_SIGNAL_SOURCE_JSON=data/ipl_live_ml.json

# Review queue file for watcher-drafted signals awaiting approval
# TELEGRAM_SIGNAL_QUEUE_PATH=data/telegram_signal_queue.json

