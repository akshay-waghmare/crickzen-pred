# CrickenZen Dashboard Environment Variables
# Copy this file to .env and fill in values

# REQUIRED — JWT signing secret (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET=change-me-to-a-random-secret

# REQUIRED — Domain for HTTPS (used by Caddy for Let's Encrypt)
DOMAIN=localhost

# REQUIRED — Admin account seeded on first startup
ADMIN_EMAIL=admin@crickenzen.com
ADMIN_PASSWORD=change-me
ADMIN_FORCE_SYNC=false

# OPTIONAL — Polling interval in milliseconds (default: 3000)
POLL_INTERVAL_MS=3000

# OPTIONAL — Directory for prediction state JSON files
STATE_DIR=data/dashboard_states

# OPTIONAL — SQLite database URL (default: sqlite:///./auth.db)
DATABASE_URL=sqlite:///./auth.db

# OPTIONAL — Access token expiry in minutes (default: 55)
ACCESS_TOKEN_EXPIRE_MINUTES=55

# OPTIONAL — Refresh token expiry in days (default: 30)
REFRESH_TOKEN_EXPIRE_DAYS=30

# OPTIONAL — Maximum active sessions across all users (default: 50)
SESSION_CAP=50

# OPTIONAL — Max concurrent predictions per user (default: 2)
MAX_USER_MATCHES=2

# OPTIONAL — Max concurrent predictions system-wide (default: 6)
MAX_TOTAL_MATCHES=6

# OPTIONAL — Automatically discover/start CREX predictions
AUTO_PREDICTIONS_ENABLED=false
AUTO_LEAGUE_KEY=IPL
AUTO_LEAGUE_KEYS=
AUTO_EXCLUDE_LEAGUES=

# OPTIONAL — Direct CREX URLs to auto-start. For current PSL testing:
# AUTO_MATCH_URLS=https://crex.com/cricket-live-score/lhq-vs-qtg-30th-match-pakistan-super-league-2026-match-updates-10XH
AUTO_MATCH_URLS=

# OPTIONAL — Additional CREX pages to scan for match links
AUTO_DISCOVERY_URLS=
AUTO_DISCOVER_FROM_CREX=true
AUTO_DISCOVERY_RENDER_JS=true
AUTO_DISCOVERY_INTERVAL_SECONDS=300
AUTO_START_NOT_BEFORE_LOCAL=17:00
AUTO_START_NOT_AFTER_LOCAL=23:59
AUTO_TIMEZONE=Asia/Kolkata

# OPTIONAL — Path to project root (auto-detected if empty)
PROJECT_ROOT=

# OPTIONAL — Allow self-registration (default: true)
REGISTRATION_OPEN=true
