# CrickZen dashboard production environment

JWT_SECRET=change-me-to-a-random-secret
DOMAIN=app.crickzen.com
ADMIN_EMAIL=admin@crickzen.com
ADMIN_PASSWORD=change-me
ADMIN_FORCE_SYNC=false

POLL_INTERVAL_MS=3000
STATE_DIR=/app/data/dashboard_states
DATABASE_URL=sqlite:////app/data/dashboard_auth.db

ACCESS_TOKEN_EXPIRE_MINUTES=55
REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_CAP=50
MAX_USER_MATCHES=2
MAX_TOTAL_MATCHES=6

AUTO_PREDICTIONS_ENABLED=true
AUTO_LEAGUE_KEY=IPL
AUTO_MATCH_URLS=
AUTO_DISCOVERY_URLS=
AUTO_DISCOVER_FROM_CREX=true
AUTO_DISCOVERY_RENDER_JS=true
AUTO_DISCOVERY_INTERVAL_SECONDS=300
AUTO_START_NOT_BEFORE_LOCAL=17:00
AUTO_START_NOT_AFTER_LOCAL=23:59
AUTO_TIMEZONE=Asia/Kolkata

PROJECT_ROOT=/app
REGISTRATION_OPEN=true
